{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "gpt-4",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "xxx@qq.com",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "LWN.net (subscriber full-text)",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "users": [
        {
          "username": "iamthatis",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10
        }
      ],
      "fetch_comments": 5
    }
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24
  },
  "profile": {
    "audience": "AI 工程师、软件开发者，以及关注技术趋势的读者",
    "score_bands": {
      "9_10": [
        "基础模型、推理系统或芯片栈出现实质性突破",
        "会显著改变开发者工作流、成本结构或行业竞争格局的关键事件"
      ],
      "7_8": [
        "重要模型、开源项目、开发工具链或基础设施更新",
        "对工程实践和技术判断有明显参考价值"
      ]
    },
    "scoring_focus": [
      "技术深度、原创性与信息密度",
      "对开发者生态或产业趋势的潜在影响"
    ],
    "downrank_if": [
      "纯营销软文或缺乏事实支撑的宣传",
      "与目标领域无关或信息密度过低的内容"
    ],
    "concept_focus": "模型、框架、协议、开源项目或行业术语等需要补充解释的概念",
    "search_hints": ["GitHub", "OpenAI", "Anthropic"]
  }
}
